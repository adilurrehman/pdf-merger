{
  "name": "pdf-merger",
  "version": "1.0.0",
  "description": "A free, fast, and secure online tool to merge multiple PDF files into a single document",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:views": "node scripts/build-views.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "keywords": [
    "pdf",
    "merge",
    "pdf-merger",
    "nodejs",
    "express"
  ],
  "author": "Adil ur Rehman Kakar <adilurrehmanofficial@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adilurrehman/pdf-merger.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.3",
    "pdf-merger-js": "^5.1.2",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "wrangler": "^4.131.0"
  }
}
