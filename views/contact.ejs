<%- include('partials/header') %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Hero Section -->
            <div class="text-center mb-5">
                <div class="contact-icon-wrapper mb-4">
                    <i class="bi bi-envelope-paper-fill"></i>
                </div>
                <h1 class="display-5 fw-bold text-white">Contact Us</h1>
                <p class="text-muted">Have questions or feedback? We'd love to hear from you!</p>
            </div>
            
            <div id="contactSuccess" class="alert alert-success d-none align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span class="alert-text"></span>
            </div>
            
            <div id="contactError" class="alert alert-danger d-none align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span class="alert-text"></span>
            </div>
            
            <div class="contact-card">
                <form id="contactForm" method="POST" action="/contact">
                    <!-- Web3Forms fields. The access key is public by design: it only submits to this form's inbox -->
                    <input type="hidden" name="access_key" value="608dcbd3-ff87-4e85-b5b5-3eae6470ed11">
                    <input type="hidden" name="subject" value="[PDF Merger] Contact Form">
                    <input type="hidden" name="from_name" value="PDF Merger">
                    <input type="checkbox" name="botcheck" class="d-none" tabindex="-1" autocomplete="off">
                    <div class="mb-4">
                        <label for="name" class="form-label text-light">
                            <i class="bi bi-person-fill me-2"></i>Your Name
                        </label>
                        <input type="text" class="form-control form-control-lg bg-dark text-light border-secondary" 
                               id="name" name="name" placeholder="Enter your name" required>
                    </div>
                    <div class="mb-4">
                        <label for="email" class="form-label text-light">
                            <i class="bi bi-envelope-fill me-2"></i>Email Address
                        </label>
                        <input type="email" class="form-control form-control-lg bg-dark text-light border-secondary" 
                               id="email" name="email" placeholder="Enter your email" required>
                    </div>
                    <div class="mb-4">
                        <label for="message" class="form-label text-light">
                            <i class="bi bi-chat-left-text-fill me-2"></i>Your Message
                        </label>
                        <textarea class="form-control bg-dark text-light border-secondary" 
                                  id="message" name="message" rows="5" placeholder="Write your message here..." required></textarea>
                    </div>
                    <button type="submit" id="contactSubmit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-send-fill me-2"></i>Send Message
                    </button>
                </form>
            </div>
            
            <!-- Contact Info Cards -->
            <div class="row mt-5 g-4">
                <div class="col-md-4">
                    <div class="contact-info-card text-center">
                        <i class="bi bi-envelope-fill text-primary"></i>
                        <h6>Email</h6>
                        <a href="mailto:adilurrehmanofficial@gmail.com">adilurrehmanofficial@gmail.com</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="contact-info-card text-center">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <h6>Location</h6>
                        <p class="text-muted mb-0">Lahore, Pakistan</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="contact-info-card text-center">
                        <i class="bi bi-clock-fill text-success"></i>
                        <h6>Response Time</h6>
                        <p class="text-muted mb-0">Within 24 hours</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact form: validated in the browser and sent straight to Web3Forms, no page reload -->
<script nonce="<%= nonce %>">
    (function () {
        const form = document.getElementById('contactForm');
        const submitBtn = document.getElementById('contactSubmit');
        const successAlert = document.getElementById('contactSuccess');
        const errorAlert = document.getElementById('contactError');

        // Blocked emails/domains and spam words
        const blockedDomains = ['tempmail.com', 'throwaway.com', 'mailinator.com', 'guerrillamail.com'];
        const blockedWords = ['viagra', 'casino', 'lottery', 'winner', 'free money'];

        // Show one alert (or none). Text is set with textContent, never parsed as HTML
        function showAlert(alert, text) {
            [successAlert, errorAlert].forEach(function (a) {
                a.classList.add('d-none');
                a.classList.remove('d-flex');
            });
            if (!alert) return;
            alert.querySelector('.alert-text').textContent = text;
            alert.classList.remove('d-none');
            alert.classList.add('d-flex');
            alert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function isSpam(name, email, message) {
            const content = `${name} ${email} ${message}`.toLowerCase();
            return blockedDomains.includes(email.split('@')[1]) || blockedWords.some(word => content.includes(word));
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const name = form.elements.namedItem('name').value.trim();
            const email = form.elements.namedItem('email').value.trim().toLowerCase();
            const message = form.elements.namedItem('message').value.trim();

            if (name.length < 2 || name.length > 100 || message.length < 10 || message.length > 1000 ||
                !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                showAlert(errorAlert, 'Invalid input. Name: 2-100 chars, Message: 10-1000 chars, Valid email required.');
                return;
            }
            if (isSpam(name, email, message)) {
                showAlert(errorAlert, 'Your message was flagged as spam.');
                return;
            }

            // Hidden fields (access_key, subject, from_name and botcheck if ticked) come from the form
            const data = Object.fromEntries(new FormData(form));
            Object.assign(data, { name: name, email: email, message: message });

            submitBtn.disabled = true;
            showAlert(null);
            try {
                const response = await fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json().catch(() => null);
                if (!response.ok || !result || result.success !== true) throw new Error('Web3Forms rejected the message');
                showAlert(successAlert, 'Message sent successfully!');
                form.reset();
            } catch (err) {
                showAlert(errorAlert, 'Failed to send message. Please try again.');
            } finally {
                submitBtn.disabled = false;
            }
        });
    })();
</script>

<%- include('partials/footer') %>